{
  "manifest_version": 2,
  "name": "FC+ Market Bridge",
  "version": "0.4.0",
  "description": "FC+ verified market execution and persistent trade ledger.",
  "browser_specific_settings": {
    "gecko": {
      "id": "fcplus@marketbrain"
    }
  },
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.ea.com/ea-sports-fc/ultimate-team/web-app/*"
      ],
      "js": [
        "trader-core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
